# OpenWeatherMap API Key (required for weather data)
# Get your free API key at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Geoapify API Key (required for location search/geocoding)
# Get your free API key at: https://www.geoapify.com/
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Weatherbit API Key (optional, for air quality backup)
# Get your free API key at: https://www.weatherbit.io/api
VITE_WEATHERBIT_API_KEY=your_weatherbit_api_key_here